{
  "name": "tennislevel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next-dev && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "normalize:tags": "ts-node --project tsconfig.scripts.json scripts/normalize-content-tags.ts --check",
    "normalize:tags:apply": "ts-node --project tsconfig.scripts.json scripts/normalize-content-tags.ts --apply",
    "normalize:tags:report": "ts-node --project tsconfig.scripts.json scripts/normalize-content-tags.ts --include-expanded",
    "prepare:xiaohongshu-seed-candidates": "ts-node --project tsconfig.scripts.json scripts/prepare-xiaohongshu-seed-candidates.ts",
    "prepare:xiaohongshu-seed-reviewed": "ts-node --project tsconfig.scripts.json scripts/prepare-xiaohongshu-seed-reviewed.ts",
    "prepare:xiaohongshu-seed-promotion": "ts-node --project tsconfig.scripts.json scripts/prepare-xiaohongshu-seed-promotion.ts",
    "validate:attached-recommendations": "vitest run src/__tests__/attached-recommendations.test.ts",
    "validate:data": "ts-node --project tsconfig.scripts.json scripts/validate-data.ts",
    "validate:data:strict": "ts-node --project tsconfig.scripts.json scripts/validate-data.ts --strict-warnings",
    "validate:plan-copy": "vitest run src/__tests__/plan-step-semantics.test.tsx src/__tests__/plan-context.test.ts",
    "validate:xiaohongshu-qa": "vitest run src/__tests__/xiaohongshu-creator-program.test.ts src/__tests__/xiaohongshu-seed-candidates.test.ts src/__tests__/xiaohongshu-seed-reviews.test.ts src/__tests__/xiaohongshu-seed-promotion.test.ts",
    "validate:profile-resume": "vitest run src/__tests__/profile-boundary-cleanup.test.tsx src/__tests__/plan-context.test.ts",
    "validate:study-docs": "ts-node --project tsconfig.scripts.json scripts/validate-study-docs.ts",
    "validate:study-remote": "ts-node --project tsconfig.scripts.json scripts/verify-study-remote.ts",
    "generate:translation-backlog": "ts-node --project tsconfig.scripts.json scripts/generate-content-translation-backlog.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "clsx": "^2.1.1",
    "next": "14.2.31",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "10.4.19",
    "jsdom": "^29.0.1",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "vitest": "^4.1.1"
  }
}
